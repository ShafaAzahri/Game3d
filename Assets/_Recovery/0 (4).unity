  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialog
  dialogLines:
  - speakerName: Nenek Rukmini
    subtitle: Tabib Desa
    text: Robby... sudah lama tidak pulang. Ayo masuk, Nenek sudah masak.
    isPlayerLine: 0
    expression: {fileID: 21300000, guid: 2e06cef0b25694f419ae16e5491c9bcc, type: 3}
  - speakerName: Robby
    subtitle: 
    text: Nenek gimana kondisinya? Kata orang Nenek sakit?
    isPlayerLine: 1
    expression: {fileID: 21300000, guid: f1d0d29f9de1251479c0cf93338505bd, type: 3}
  - speakerName: Nenek Rukmini
    subtitle: Tabib Desa
    text: Ah, Nenek baik-baik saja. Yang sakit itu desa kita ini, Cu...
    isPlayerLine: 0
    expression: {fileID: 21300000, guid: ea579748f66b68949ae2bbf37bdd5318, type: 3}
  - speakerName: Nenek Rukmini
    subtitle: Tabib Desa
    text: Kebun herbal sudah lama tidak dirawat. Nenek mau minta tolong kamu.
    isPlayerLine: 0
    expression: {fileID: 21300000, guid: 31c038fc053335f44a97a4da6928ca2e, type: 3}
  - speakerName: Robby
    subtitle: 
    text: Oke Nek, apa yang perlu aku lakukan?
    isPlayerLine: 1
    expression: {fileID: 21300000, guid: dd733666d66005042b58c6ef4a501317, type: 3}
  interactRadius: 3
  npcSilhouette: {fileID: 21300000, guid: 851661b9abfe4dc4587bf5786263ee8a, type: 3}
